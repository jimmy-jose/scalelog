# Optional public URL used for certificate sharing and verification links.
# EXPO_PUBLIC_ values are included in the client bundle: never put secrets here.
EXPO_PUBLIC_SITE_URL=

# Optional certificate artwork label for an open-source build.
EXPO_PUBLIC_OPEN_SOURCE=true

# Optional SERVER-ONLY token for the Vercel certificate registry APIs.
# Configure this in the server/deployment environment; never expose it as EXPO_PUBLIC_.
# The local game runs without it. Do not put a real token in this example file.
BLOB_READ_WRITE_TOKEN=
